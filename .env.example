# Copy to .env and fill in. Never commit .env.

# Server: 32-byte key, base64. Generate with:
#   server/.venv/bin/python -c "import sys; sys.path.insert(0,'server'); import crypto_box; print(crypto_box.new_master_key())"
# Keep it safe: if it's lost, existing prompts can't be unlocked.
MASTER_KEY=

# Which deployment the server uses: localhost or sepolia
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional: Pinata JWT for IPFS storage (free plan). Leave blank to store metadata locally.
PINATA_JWT=

# Deploying to Sepolia (test network). Use a separate test wallet only.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
PLATFORM_FEE_BPS=250

# Optional: AI assist ("Draft with AI" on the Create page). Key from console.anthropic.com.
# Without it the button is hidden. Usage is capped per visitor and per day:
ANTHROPIC_API_KEY=
ASSIST_PER_HOUR=5
ASSIST_PER_DAY=100
