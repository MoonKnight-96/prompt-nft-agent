# Copy to .env and fill in. Never commit .env.

# Server: 32-byte key, base64. Generate with:
#   server/.venv/bin/python -c "import sys; sys.path.insert(0,'server'); import crypto_box; print(crypto_box.new_master_key())"
# Keep it safe: if it's lost, existing prompts can't be unlocked.
MASTER_KEY=

# Which deployment the server uses: localhost, sepolia, amoy (Polygon test) or polygon (LIVE)
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional: Pinata JWT for IPFS storage (free plan). Leave blank to store metadata locally.
PINATA_JWT=

# Deploying contracts. RPC URLs from Alchemy or Infura.
SEPOLIA_RPC_URL=
AMOY_RPC_URL=
POLYGON_RPC_URL=
# Deployer wallet key. Test networks: a throwaway test wallet. Polygon mainnet: the operator's
# own deploy wallet, entered on her own machine only. Never share or commit it.
DEPLOYER_PRIVATE_KEY=
# Etherscan API v2 key (also works for Polygonscan) for contract verification.
ETHERSCAN_API_KEY=
PLATFORM_FEE_BPS=250
# Wallet that receives marketplace fees. Required for Polygon mainnet.
FEE_RECIPIENT=
# Must be "yes" to deploy to Polygon mainnet (safety lock).
CONFIRM_MAINNET=

# Optional operator branding shown in the site footer.
OPERATOR_NAME=
OPERATOR_TERMS_URL=
OPERATOR_CONTACT=

# Optional: AI assist ("Draft with AI" on the Create page). Key from console.anthropic.com.
# Without it the button is hidden. Usage is capped per visitor and per day:
ANTHROPIC_API_KEY=
ASSIST_PER_HOUR=5
ASSIST_PER_DAY=100
